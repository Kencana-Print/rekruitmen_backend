# ============================================================
# Salin file ini menjadi .env.local (development) atau
# .env.production (production), lalu sesuaikan nilainya.
# Aplikasi memuat file berdasarkan NODE_ENV:
#   local      -> .env.local
#   staging    -> .env.ngrok
#   production -> .env.production
# ============================================================

# ── SERVER ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=local

# ── DATABASE ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rekruitmen2

# ── AUTH ────────────────────────────────────────────────────
# WAJIB minimal 32 karakter, server menolak start jika kurang
JWT_SECRET=ganti-dengan-secret-yang-sangat-panjang-dan-aman-1234567890
JWT_EXPIRES_DAYS=1

# ── CORS / CSRF ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── GOOGLE (opsional, dipakai modul tertentu) ───────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
